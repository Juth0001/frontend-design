---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  :root {
    --none: transparent;
    --black: #181818;
    --gray: #eee;
    --white: #fff;
  }

  ul {
    list-style: none;
    padding-block: 0;
    overflow-inline: auto;
    scroll-padding-inline: max(1rem, 50% - var(--content-width) / 2);
    padding-inline: max(1rem, 50% - var(--content-width) / 2);
    overflow-inline: auto;
    scroll-snap-type: x mandatory;
    display: flex;
    gap: var(--card-gap);
  }

  .full-width {
    display: grid;
    grid: auto / repeat(4, 1fr);
    gap: 1rem;
    overflow-x: auto;
  }

  li {
    background: var(--bg-card, var(--gray));
    color: var(--text-card, var(--black));
    border-radius: 8px;
    padding: 1.5rem;
    flex: 1 0 400px;
  }
</style>
